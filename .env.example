# Public site URL
# Local: http://localhost:3000
# Production: https://your-site.netlify.app or your custom domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon public key (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role secret key (Project Settings -> API)
# Keep this secret. Do not expose in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional GA4 Measurement ID (example: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Recommended for Netlify runtime
NODE_VERSION=20
